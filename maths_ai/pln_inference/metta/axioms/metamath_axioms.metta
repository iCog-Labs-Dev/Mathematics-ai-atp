      (↔ (∧ ($phi) (⊻ ($psi) ($chi))) (⊻ (∧ ($phi) ($psi)) (∧ ($phi) ($chi)))) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse xorexmid) 
      (⊻ ($phi) (Not ($phi))) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse df-nor) 
      (↔ (⊽ ($phi) ($psi)) (Not (∨ ($phi) ($psi)))) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse norcom) 
      (↔ (⊽ ($phi) ($psi)) (⊽ ($psi) ($phi))) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse nornot) 
      (↔ (Not ($phi)) (⊽ ($phi) ($phi))) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse noran) 
      (↔ (∧ ($phi) ($psi)) (⊽ (⊽ ($phi) ($phi)) (⊽ ($psi) ($psi)))) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse noror) 
      (↔ (∨ ($phi) ($psi)) (⊽ (⊽ ($phi) ($psi)) (⊽ ($phi) ($psi)))) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse norasslem1) 
      (↔ (Implication 
         (Premises (∨ ($phi) ($psi))) 
         (Conclusions ($chi))
      ) (∨ (⊽ ($phi) ($psi)) ($chi))) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse norasslem2) 
      (Implication 
         (Premises ($phi)) 
         (Conclusions (↔ ($psi) (Implication 
               (Premises (∨ ($phi) ($chi))) 
               (Conclusions ($psi))
            )))
      ) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse norasslem3) 
      (Implication 
         (Premises (Not ($phi))) 
         (Conclusions (↔ (Implication 
               (Premises ($psi)) 
               (Conclusions ($chi))
            ) (Implication 
               (Premises (∨ ($phi) ($psi))) 
               (Conclusions ($chi))
            )))
      ) 
      (STV 1.0 1.0)
   )
)
!(compileadd kb 
   (: (no_inverse norass) 
      (↔ (↔ ($phi) ($chi)) (↔ (⊽ (⊽ ($phi) ($psi)) ($chi)) (⊽ ($phi) (⊽ ($psi) ($chi))))) 
      (STV 1.0 1.0)
   )
)


!(compileadd kb 
   (: (no_inverse rule-abduction) 
      (Implication 
         (Premises 
            (Implication 
               (Premises ($phi)) 
               (Conclusions ($chi))
            )
            (Implication 
               (Premises ($psi)) 
               (Conclusions ($chi))
            )
         ) 
         (Conclusions 
            (Implication 
               (Premises ($phi)) 
               (Conclusions ($psi))
            )
         )
      ) 
      (STV 0.5 0.4)
   )
)
!(compileadd kb 
   (: (no_inverse rule-induction) 
      (Implication 
         (Premises 
            (Implication 
               (Premises ($chi)) 
               (Conclusions ($phi))
            )
            (Implication 
               (Premises ($chi)) 
               (Conclusions ($psi))
            )
         ) 
         (Conclusions 
            (Implication 
               (Premises ($phi)) 
               (Conclusions ($psi))
            )
         )
      ) 
      (STV 0.5 0.4)
   )
)
!(compileadd kb
   (: (no_inverse df-or)
      (↔ (∨ ($phi) ($psi)) (Implication (Premises (Not ($phi))) (Conclusions ($psi))))
      (STV 1.0 1.0)
   )
)
!(compileadd kb
   (: (no_inverse df-or-1)
      (↔ (Implication (Premises (Not ($phi))) (Conclusions ($psi)))(∨ ($phi) ($psi)))
      (STV 1.0 1.0)
   )
)

;; pm4.64: (φ → ψ) ↔ (¬φ ∨ ψ)
!(compileadd kb
   (: (no_inverse pm4.64)
      (↔ (Implication (Premises ($phi)) (Conclusions ($psi)))
         (∨ (Not ($phi)) ($psi)))
      (STV 1.0 1.0)
   )
)

;; exmid: φ ∨ ¬φ  (Law of Excluded Middle)
!(compileadd kb
   (: (no_inverse exmid)
      (∨ ($phi) (Not ($phi)))
      (STV 1.0 1.0)
   )
)
