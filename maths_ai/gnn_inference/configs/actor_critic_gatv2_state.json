{
  "prepared_root": "maths_ai/gnn_inference/artifacts/prepared/v1",
  "run_root": "maths_ai/gnn_inference/runs/actor_critic_gatv2_state",
  "seed": 42,
  "device": "auto",
  "edge_mode": "bidirectional",
  "arg_loss_weight": 0.5,
  "critic_weight": 0.5,
  "entropy_weight": 0.01,
  "arg_lr_multiplier": 0.1,
  "pretrained_pointer_checkpoint": "runs/pointer_gatv2_state/<run>/best.pt",
  "model": {
    "architecture": "gatv2",
    "hidden_dim": 512,
    "dropout": 0.2,
    "use_node_type": true,
    "max_args": 3,
    "encoder": {"num_layers": 4, "heads": 8, "readout": "state"}
  },
  "training": {
    "batch_size": 256,
    "epochs": 200,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "log_every_batches": 100,
    "num_workers": 12,
    "pin_memory": true,
    "persistent_workers": true,
    "prefetch_factor": 2,
    "use_amp": true,
    "max_batch_nodes": 100000,
    "max_batch_edges": 400000,
    "oversize_graph_policy": "error",
    "cache_in_memory": true
  }
}
